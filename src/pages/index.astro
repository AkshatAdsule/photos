---
import BaseLayout from "../layouts/BaseLayout.astro";
import AlbumPreview from "../components/AlbumPreview.astro";
import { albums } from "../lib/albums";
---

<BaseLayout
  title="Photos by Akshat"
  description="A collection of photos taken by me"
>
  <main class="album-index">
    <h1 class="visually-hidden">Photos by Akshat</h1>
    {
      albums.map((album, index) => (
        <AlbumPreview album={album} eagerCount={index === 0 ? 2 : 0} />
      ))
    }
  </main>
</BaseLayout>

<style>
  .album-index {
    padding: 12px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .album-index :global(.album-preview + .album-preview) {
    margin-top: 28px;
  }

  @media (min-width: 700px) {
    .album-index {
      padding: 28px 0 72px;
    }

    .album-index :global(.album-preview + .album-preview) {
      margin-top: 54px;
    }
  }

  @media (min-width: 1440px) {
    .album-index :global(.album-preview + .album-preview) {
      margin-top: 64px;
    }
  }
</style>
