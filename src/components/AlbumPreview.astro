---
import type { Album } from "../lib/albums";
import PhotoGrid from "./PhotoGrid.astro";

interface Props {
  album: Album;
}

const { album } = Astro.props;
---

<article class="album-preview">
  <header class="album-preview__header">
    <div>
      <h2>{album.title}</h2>
      <p>{album.description}</p>
    </div>
    <a href={`/albums/${album.slug}/`} class="album-preview__link">
      View album
    </a>
  </header>
  <PhotoGrid
    photos={album.photos}
    galleryId={`preview-${album.slug}`}
    eagerCount={9}
    preview
  />
</article>

<style>
  .album-preview {
    position: relative;
  }

  .album-preview__header {
    font-size: 3rem;
    width: var(--page-width);
    margin: 0 auto 5px;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 6px;    
  }

  .album-preview__header h2 {
    margin: 0;
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .album-preview__header p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .album-preview__link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    border: 1px solid currentColor;
    padding: 0 10px;
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.12s ease,
      color 0.16s ease;
    width: fit-content;
  }

  .album-preview__link:hover {
    background-color: var(--text);
    color: var(--bg);
  }

  .album-preview::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 64px;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--bg)
    );
  }

  @media (max-width: 700px) {
    .album-preview__header {
      grid-template-columns: 1fr;
    }

    .album-preview__link {
      justify-self: start;
    }
  }

  @media (min-width: 700px) {
    .album-preview__header {
      margin-bottom: 10px;
    }

    .album-preview__header p {
      font-size: 1rem;
    }

    .album-preview::after {
      height: 120px;
    }
  }
</style>
