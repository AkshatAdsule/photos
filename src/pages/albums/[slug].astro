---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AlbumPageHeader from "../../components/AlbumPageHeader.astro";
import FancyboxSetup from "../../components/FancyboxSetup.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import { albums, getAlbum } from "../../lib/albums";

export function getStaticPaths() {
  return albums.map((album) => ({
    params: { slug: album.slug }
  }));
}

const album = getAlbum(Astro.params.slug ?? "");

if (!album) {
  return Astro.redirect("/");
}
---

<BaseLayout
  title={`${album.title} Photos`}
  description={album.description}
  image={{ src: album.photos[0]?.image.src ?? "", alt: album.photos[0]?.alt ?? "" }}
>
  <main class="album-page">
    <AlbumPageHeader album={album} />
    <PhotoGrid photos={album.photos} galleryId={`album-${album.slug}`} />
  </main>
  <FancyboxSetup />
</BaseLayout>

<style>
  .album-page {
    padding: 12px 0 32px;
  }

  @media (min-width: 700px) {
    .album-page {
      padding: 28px 0 72px;
    }
  }
</style>
