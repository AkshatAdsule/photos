---
import BaseLayout from "../layouts/BaseLayout.astro";
import AlbumPreview from "../components/AlbumPreview.astro";
import FancyboxSetup from "../components/FancyboxSetup.astro";
import { albums } from "../lib/albums";
---

<BaseLayout
  title="Photos by Akshat"
  description="A collection of photos taken by me"
>
  <main class="album-index">
    {
      albums.map((album) => (
        <AlbumPreview album={album} />
      ))
    }
  </main>
  <FancyboxSetup />
</BaseLayout>

<style>
  .album-index {
    padding: clamp(12px, 2vw, 28px) 0 clamp(32px, 5vw, 72px);
  }

  .album-index :global(.album-preview + .album-preview) {
    margin-top: clamp(28px, 4.5vw, 64px);
  }
</style>
