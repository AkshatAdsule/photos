---
import "~/styles/reset.css";
import "~/styles/base.css";
import { ClientRouter, fade } from "astro:transitions";
import { Font } from "astro:assets";

import smartypants from "smartypants";

const siteName = "Photos by Akshat";

export interface Props {
  title: string;
  description: string;
  image?: {
    src: string;
    alt: string;
  };
}

const { title, description, image } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = Astro.url.pathname === "/" ? title : `${title} · ${siteName}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title set:html={smartypants(pageTitle, 1)} />
    <meta name="description" content={smartypants(description, 1)} />
    <meta property="og:title" content={smartypants(title, 1)} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={smartypants(description, 1)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />
    <Font cssVariable="--font-manrope" />
    <ClientRouter />
    {
      image && (
        <>
          <meta property="og:image" content={new URL(image.src, Astro.site).href} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }
  </head>
  <body transition:animate={fade({ duration: "180ms" })}>
    <slot />
  </body>
</html>

<script>
  import type { TransitionBeforePreparationEvent } from "astro:transitions/client";

  type AlbumPosition = { y: number; href?: string };
  const storageKey = "photos:album-position";
  let position: AlbumPosition | undefined;
  let restoreAlbums = false;

  try {
    const saved = JSON.parse(sessionStorage.getItem(storageKey) ?? "null");
    if (saved && Number.isFinite(saved.y) && saved.y >= 0) position = saved;
  } catch { /* Storage can be unavailable in private browsing. */ }

  document.addEventListener("astro:before-preparation", (event) => {
    const navigation = event as TransitionBeforePreparationEvent;
    restoreAlbums = navigation.navigationType !== "traverse" &&
      !!navigation.sourceElement?.closest("[data-return-to-albums]");

    if (navigation.from.pathname === "/") {
      const link = navigation.sourceElement?.closest<HTMLAnchorElement>("a");
      position = { y: window.scrollY, href: link?.getAttribute("href") ?? undefined };
      try { sessionStorage.setItem(storageKey, JSON.stringify(position)); } catch {}
    }
  });

  document.addEventListener("astro:after-swap", () => {
    // Back/Forward stays with Astro's per-history-entry restoration.
    if (restoreAlbums && location.pathname === "/" && position) {
      const link = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[href]"))
        .find((link) => link.getAttribute("href") === position?.href);
      link?.focus({ preventScroll: true });
      window.scrollTo({ top: position.y, behavior: "instant" });
    }
    restoreAlbums = false;
  });
</script>
