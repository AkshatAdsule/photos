---
import type { Album } from "../lib/albums";

interface Props {
  album: Album;
}

const { album } = Astro.props;
---

<header class="album-page-header">
  <a href="/" class="album-page-header__back-link">All albums</a>
  <h1>{album.title}</h1>
  <p>{album.description}</p>
</header>

<style>
  .album-page-header {
    width: var(--page-width);
    margin: 0 auto 10px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--line);
  }

  .album-page-header__back-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    margin-bottom: 18px;
    border: 2px solid currentColor;
    padding: 0 10px;
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.12s ease,
      color 0.16s ease;
  }

  .album-page-header__back-link:hover {
    background-color: var(--text);
    color: var(--bg);
  }

  .album-page-header h1 {
    margin: 0;    
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .album-page-header p {
    max-width: 58ch;
    margin: 8px 0 0;
    color: var(--muted);
    line-height: 1.4;
  }

  @media (min-width: 700px) {
    .album-page-header {
      margin-bottom: 18px;
    }

    .album-page-header__back-link {
      margin-bottom: 36px;
    }

    .album-page-header p {
      font-size: 1rem;
    }
  }

  @media (min-width: 1440px) {
    .album-page-header__back-link {
      margin-bottom: 40px;
    }

    .album-page-header h1 {
      font-size: 5.5rem;
    }
  }
</style>
